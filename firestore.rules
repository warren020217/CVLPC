rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Private reservation records. Players can retrieve a reservation only
    // when they know its 8-character access code.
    match /reservations/{reservationId} {
      allow create: if
        request.resource.data.status == 'Pending' &&
        request.resource.data.name is string && request.resource.data.name.size() >= 2 &&
        request.resource.data.email is string && request.resource.data.email.size() >= 5 &&
        request.resource.data.phone is string && request.resource.data.phone.size() >= 7 &&
        request.resource.data.date is string && request.resource.data.time is string &&
        request.resource.data.players is string &&
        request.resource.data.accessCode is string && request.resource.data.accessCode.size() == 8 &&
        reservationId == request.resource.data.accessCode;

      allow get: if isAdmin() ||
        (resource.data.accessCode == reservationId);

      allow list: if isAdmin();

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','approvedAt','rejectedAt','adminNote','updatedAt']);

      allow delete: if isAdmin();
    }

    // Safe public booking board. Never stores player name, email, or phone.
    match /publicBookings/{bookingId} {
      allow read: if true;

      allow create: if
        request.resource.data.status == 'Pending' &&
        request.resource.data.accessCode is string &&
        request.resource.data.accessCode.size() == 8 &&
        bookingId == request.resource.data.accessCode &&
        request.resource.data.date is string &&
        request.resource.data.time is string &&
        request.resource.data.players is string &&
        request.resource.data.reservationNo is string;

      allow update, delete: if isAdmin();
    }
  }
}
